# Deep Research configuration
# Copy to .env and fill in your values. .env is git-ignored.

# --- Ollama ---
OLLAMA_BASE_URL=https://ollama.com
EMBED_BASE_URL=http://192.168.25.188:11434
# OLLAMA_API_KEY=                    # optional: required by some cloud/authenticated Ollama hosts

# --- Chat model tiers (served by the Ollama host) ---
MODEL_FAST=deepseek-v4-flash:cloud
MODEL_LONG=deepseek-v4-pro:cloud
MODEL_WRITER=gemma4:31b-cloud
EMBED_MODEL=mxbai-embed-large

# --- PDF conversion ---
# pymupdf  → fast, no model downloads, good for machine-readable PDFs (default)
# marker   → local OCR via marker-pdf; requires: uv sync --extra ocr
# remote   → POST to a remote marker server; set PDF_CONVERTER_URL below
PDF_CONVERTER=pymupdf
# PDF_CONVERTER_URL=http://192.168.25.188:8080/convert   # required when PDF_CONVERTER=remote
# PDF_CONVERTER_API_KEY=                                  # optional: Bearer token for the remote server

# --- API keys ---
TAVILY_API_KEY=

# --- Paths ---
BIBLIOGRAPHY_DIR=./Bibliography
OUTPUT_DIR=./Research
STATE_DIR=./.deepresearch

# --- Tavily ---
# Minimum seconds between any two Tavily calls across all parallel subagents.
# Increase if you hit rate limits; decrease on a paid plan with a higher quota.
TAVILY_REQUEST_DELAY=1.0

# --- Caps & knobs ---
MAX_CONCURRENCY=2
SUBAGENT_MAX_ITERATIONS=5
AUTO_ROUND_CAP=2
MAX_ROUNDS=5
SUBTOPICS_TARGET=5
SUBTOPICS_CEILING=12
RETRIEVAL_K=10
SIMILARITY_FLOOR=0.5
# Web source quality filter: reject pages with too little prose or too many links.
MIN_SOURCE_WORDS=150
MAX_LINK_DENSITY=0.5
PROVENANCE_BOOST=0.05
DOC_SIZE_CAP=50000
