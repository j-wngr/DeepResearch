{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/.venv/**"
    ]
  },
  "formatter": true,
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "ollama-cloud/deepseek-v4-pro",
      "reasoningEffort": "high",
      "temperature": 0.6
    },
    "build": {
      "mode": "primary",
      "model": "ollama-cloud/kimi-k2.7-code",
      "temperature": 0.2
    }
  }
}
